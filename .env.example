# Copia este archivo a .env y rellena tus valores.
# .env NO se sube al repositorio (estÃ¡ en .gitignore).

# Puerto (los hosting lo asignan automÃ¡ticamente con PORT)
PORT=3000

# Rutas de datos (en local se auto-crean en la carpeta del proyecto;
# en los hosting apuntan a un volumen persistente, p.ej. /data)
# DATA_DIR=
# UPLOAD_DIR=

# Clave secreta para las sesiones. IMPRESCINDIBLE generarla Ãºnica y segura:
# en Linux/macOS:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# en Windows:      node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SECRETO_SESION=cambia-esta-clave-por-una-aleatoria-de-96-caracteres

# Origen pÃºblico del sitio (para OAuth de Google). Ejemplos:
#   local:   http://localhost:3000
#   render:  https://oraculo1-hhwc.onrender.com
ORIGEN_PUBLICO=http://localhost:3000

# OAuth de Google (opcional). DÃ©jalo vacÃ­o para usar solo email/contraseÃ±a.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
