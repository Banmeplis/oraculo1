# Copia este archivo a .env y rellena tus valores.
# .env NO se sube al repositorio (está en .gitignore).

# Puerto (los hosting lo asignan automáticamente con PORT)
PORT=3000

# Rutas de datos (en local se auto-crean en la carpeta del proyecto;
# en los hosting apuntan a un volumen persistente, p.ej. /data)
# DATA_DIR=
# UPLOAD_DIR=

# Clave secreta para las sesiones. IMPRESCINDIBLE generarla única y segura:
# en Linux/macOS:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# en Windows:      node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SECRETO_SESION=cambia-esta-clave-por-una-aleatoria-de-96-caracteres

# Origen público del sitio (para OAuth de Google). Ejemplos:
#   local:   http://localhost:3000
#   render:  https://tu-app.onrender.com
ORIGEN_PUBLICO=http://localhost:3000

# OAuth de Google (opcional). Déjalo vacío para usar solo email/contraseña.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Usuario maestro (rol admin intocable). Quien use este correo es siempre admin.
MASTER_EMAIL=juanshinku@gmail.com

# ─── Sincronización (producción → local) ───────────────────────────────────
# El gancho git pre-push descarga los USUARIOS y los ARTÍCULOS nuevos de
# Render hacia esta BD local cada vez que haces commit + push. El sitio
# desplegado solo LEE su base: la sincronización nunca sube datos.
# Debe coincidir EXACTAMENTE con el valor que pongas en las variables de
# entorno del hosting (Render → Environment → SYNC_TOKEN).
SYNC_TOKEN=pon-aqui-un-token-largo-y-unico
# URL del sitio desplegado (de donde se descargan los datos)
SYNC_ORIGEN=https://oraculo1-hhwc.onrender.com

# ─── Inteligencia artificial (opcional) ─────────────────────────────────────
# La IA de las tiradas, la pregunta al oráculo y el horóscopo usan OpenAI si
# OPENAI_API_KEY está configurada; si no, prueban Hugging Face gratuita.
#
# OpenAI / ChatGPT (recomendado): https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Modelo por defecto (puedes usar gpt-4o, gpt-4o-mini, gpt-4-turbo, etc.)
OPENAI_MODEL=gpt-4o-mini
# Opcional: apuntar a otra API compatible (Groq, Together, LM Studio local...)
# OPENAI_BASE_URL=https://api.groq.com/openai/v1

# Hugging Face gratuita (si OPENAI_API_KEY está vacía, se usa esto)
HF_TOKEN=
# Modelos de HF a probar en orden (separados por coma)
# HF_MODELOS=mistralai/Mistral-7B-Instruct-v0.2,google/flan-t5-large
